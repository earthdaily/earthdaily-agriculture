# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Workspace data directories
inputs/
results/
partials/
logs/
cache/

# Environment & credentials
.env
.env.*
!template.env
!src/template.env
# The project template's credentials EXAMPLE (docs/01: `cp .env.template .env`).
# Without this, `.env.*` drops it at the mirror's `git add -A` even though the
# payload contains it — see assert_nothing_gitignored().
!project_template/**/.env.template

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.ipynb_checkpoints/
