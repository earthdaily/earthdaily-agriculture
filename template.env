# earthdaily-agriculture — credentials template
#
# Copy this to `.env` at the ROOT of your project (next to your notebook or
# script) and fill in the values:
#
#     cp template.env .env
#
# The package searches, in order: <project_root>/.env, <project_root>/src/.env,
# then the working directory. Project root is the normal choice — `src/.env`
# exists for repository checkouts that keep credentials beside the source.
#
# Never commit a filled-in .env. Request trial access at
# https://earthdaily.com/ag-contact

# Which environment the credentials below are for: prod or preprod.
ENVIRONMENT=prod

# ---------------------------------------------------------------------------
# EarthDaily Agriculture API credentials  (required)
# ---------------------------------------------------------------------------
# Prefixed names win over the bare ones, so you can keep both environments in
# a single file and switch with ENVIRONMENT above.
PROD_API_CLIENT_ID=
PROD_API_CLIENT_SECRET=
PROD_API_USERNAME=
PROD_API_PASSWORD=

# PREPROD_API_CLIENT_ID=
# PREPROD_API_CLIENT_SECRET=
# PREPROD_API_USERNAME=
# PREPROD_API_PASSWORD=

# ---------------------------------------------------------------------------
# AWS S3  (optional — only to read or write s3:// URIs; install `.[s3]`)
# ---------------------------------------------------------------------------
# Leave blank to use the default AWS credential chain (instance/task role,
# ~/.aws/credentials, SSO). Set AWS_ENDPOINT_URL for MinIO or LocalStack.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Azure Blob Storage  (optional — only to write az:// URIs; install `.[azure]`)
# ---------------------------------------------------------------------------
# Set ONE of: connection string, account name + SAS token, or account name + key.
# Leave all blank to use the default credential chain (Managed Identity, az CLI).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_ACCOUNT_KEY=
