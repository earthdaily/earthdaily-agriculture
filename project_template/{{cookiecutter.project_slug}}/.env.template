# {{ cookiecutter.project_name }} — credentials
#
#     cp .env.template .env
#
# then fill in the values below. `.env` is git-ignored; never commit it.
# Trial access: https://earthdaily.com/ag-contact

# Which credentials the run uses: prod or preprod.
ENVIRONMENT={{ cookiecutter.environment }}

# Prod credentials
PROD_API_CLIENT_ID=
PROD_API_CLIENT_SECRET=
PROD_API_USERNAME=
PROD_API_PASSWORD=

# Preprod credentials
PREPROD_API_CLIENT_ID=
PREPROD_API_CLIENT_SECRET=
PREPROD_API_USERNAME=
PREPROD_API_PASSWORD=

# AWS S3 — optional, only for s3:// inputs/outputs (install the `s3` extra).
# Leave blank to use the default credential chain (role, ~/.aws, SSO).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Azure Blob — optional, only for az:// outputs (install the `azure` extra).
# Set ONE, or leave all blank to use the default chain (Managed Identity, az CLI).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_ACCOUNT_KEY=
